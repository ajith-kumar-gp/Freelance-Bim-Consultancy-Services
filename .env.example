# EmailJS Configuration (required to send real emails from the Contact/Booking forms).
# Copy this file to .env.local for local dev, and add the same keys in
# Netlify > Site configuration > Environment variables for production.
# See emailjs.md for how to get these values.
VITE_EMAILJS_SERVICE_ID="your_service_id"
VITE_EMAILJS_TEMPLATE_ID="your_template_id"
VITE_EMAILJS_PUBLIC_KEY="your_public_key"
